PORT=5000
NODE_ENV=development

# Neon: pooled URL for the app, direct URL for migrations.
# Neon is reached over WebSockets on port 443 (works on networks that block 5432).
# Set DB_TRANSPORT=tcp to use a plain TCP connection instead (e.g. local Postgres).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`)
JWT_SECRET=
PEPPER=

# Frontend origin (used in email links and CORS)
APP_URL=http://localhost:3000

# Business defaults (optional)
TRIAL_DAYS=15
GRACE_DAYS_MONTHLY=7
GRACE_DAYS_YEARLY=14

# Set to false to run the API without the in-process worker (outbox relay + scheduled jobs)
RUN_WORKER=true
